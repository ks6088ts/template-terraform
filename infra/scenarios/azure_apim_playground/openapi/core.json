{
  "openapi": "3.0.1",
  "info": {
    "title": "APIM Playground Core API",
    "version": "1.0.0",
    "description": "Self-contained operations for validating Azure API Management policies."
  },
  "paths": {
    "/hello": {
      "get": {
        "operationId": "get-hello",
        "summary": "Return a deterministic playground response",
        "responses": {
          "200": {
            "description": "A deterministic response generated by an APIM policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaygroundResponse"
                },
                "example": {
                  "message": "hello from Azure API Management",
                  "source": "policy"
                }
              }
            }
          }
        }
      }
    },
    "/mock": {
      "get": {
        "operationId": "get-mock",
        "summary": "Return a response generated by the APIM mock-response policy",
        "responses": {
          "200": {
            "description": "A response generated from the OpenAPI example",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaygroundResponse"
                },
                "example": {
                  "message": "mocked by Azure API Management",
                  "source": "mock-response"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PlaygroundResponse": {
        "type": "object",
        "required": ["message", "source"],
        "properties": {
          "message": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    }
  }
}
